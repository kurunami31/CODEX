# ── CODEX environment ────────────────────────────────────────────────
# Copy this file to `.env` and fill in the values.

# Supabase project credentials (Project Settings → API)
# URL looks like: https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=
SUPABASE_ANON_KEY=

# GROQ API key for the AI Assistant (https://console.groq.com/keys)
GROQ_API_KEY=

# ── SECURITY ────────────────────────────────────────────────────
# Secret used to sign student QR codes (HMAC-SHA256). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it secret — never commit it, never expose it to the browser.
SECRET_KEY=

# Optional: override the GROQ model used by the assistant
# GROQ_MODEL=llama-3.3-70b-versatile
